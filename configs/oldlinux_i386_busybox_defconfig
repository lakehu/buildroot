# Static i386 BusyBox (uClibc-ng, no threads/TLS) for Linux 0.01/0.11 ELF kernels.
# Only the busybox binary is used: output/build/busybox-*/busybox
BR2_x86_i486=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="6.12.9"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_PTHREADS_NONE=y
BR2_GLOBAL_PATCH_DIR="board/oldlinux/patches board/oldlinux/patches-linux001"
BR2_UCLIBC_CONFIG_FRAGMENT_FILES="board/oldlinux/uclibc.fragment"
BR2_STATIC_LIBS=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="board/oldlinux/busybox.config"
# BR2_TARGET_ROOTFS_TAR is not set
